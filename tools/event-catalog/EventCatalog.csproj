<Project Sdk="Microsoft.NET.Sdk">
  <!-- Read-only research tool: reads DiRT 3's database with EgoEngineLibrary (MIT, Petar Tasev).
       Not part of tools/build.ps1 or the package. Point EgoLibraryDir at a built EgoEngineLibrary. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EgoLibraryDir Condition="'$(EgoLibraryDir)' == ''">..\..\..\DiRT2VR\artifacts\ego-converter</EgoLibraryDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(EgoLibraryDir)\EgoEngineLibrary.dll" />
    <Reference Include="$(EgoLibraryDir)\CommunityToolkit.HighPerformance.dll" />
  </ItemGroup>
</Project>
