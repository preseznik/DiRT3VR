<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>DiRT3VR</RootNamespace>
    <StartupObject>DiRT3VR.Program</StartupObject>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>DiRT3VR</AssemblyName>
    <Version>0.1.20</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\DiRT3VR.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <Import Include="System.IO" />
    <Import Include="System.Diagnostics" />
    <Import Include="System.Threading.Tasks" />
  </ItemGroup>
  <ItemGroup>
    <!-- Windows also show the icon; single-file publishing keeps it as a managed resource. -->
    <EmbeddedResource Include="assets\DiRT3VR.ico" LogicalName="DiRT3VR.ico" />
    <!-- DiRT 3's quality options and presets, generated by tools/extract_graphics_options.py. -->
    <EmbeddedResource Include="..\tools\data\graphics-options.json" LogicalName="DiRT3VR.graphics-options.json" />
  </ItemGroup>
</Project>
