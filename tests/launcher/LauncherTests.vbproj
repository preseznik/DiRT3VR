<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <OptionStrict>On</OptionStrict>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <RootNamespace>LauncherTests</RootNamespace>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../../launcher/DiRT3VR.vbproj" /></ItemGroup>
  <ItemGroup><None Update="fixtures/hardware_settings_restrictions.xml" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup>
    <None Include="../../build/research/startup-movies/states-original.bin" Link="fixtures/startup-states.bin" CopyToOutputDirectory="PreserveNewest" Condition="Exists('../../build/research/startup-movies/states-original.bin')" />
  </ItemGroup>
</Project>
